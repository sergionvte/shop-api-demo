# Copia a .env.demo para `make docker-run` (mismas variables que en Render).
ENVIRONMENT=production
SECRET_KEY=cambia-esto-por-una-clave-aleatoria-de-32-o-mas-caracteres
DATABASE_URL=sqlite+aiosqlite:////tmp/demo.db
ALLOW_SQLITE_IN_PRODUCTION=true
ALLOWED_HOSTS=localhost,127.0.0.1
DOCS_ENABLED=true
PORT=8000
DEMO_ADMIN_EMAIL=admin@example.com
DEMO_ADMIN_PASSWORD=
