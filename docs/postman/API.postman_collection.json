    {
      "name": "Account",
      "description": "Recuperación de contraseña, verificación y cambio de email (solo si la API tiene `PASSWORD_RESET=on` o `EMAIL_VERIFICATION=optional|required`; si no, responden 403).\n\nLos enlaces de los correos llevan el token en el fragmento: `.../reset-password#token=pr_...`. Copia el token (lo que va después de `#token=`) en la variable `resetToken` o `verifyToken`, de la colección o de tu *Environment* (se leen con `pm.variables.get`, valen las dos). En local: con `EMAIL_BACKEND=console` sale en el log de la API; con `EMAIL_BACKEND=file`, abre el `.txt` (no el `.eml`, que parte el token); con `make mail` (Mailpit), en http://localhost:8025. Sin token, esas peticiones comprueban el rechazo (400/422). Con newman: `--env-var resetToken=... --env-var verifyToken=...`.",
      "item": [
        {
          "name": "Account features",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/auth/features",
              "host": [
                "{{baseUrl}}{{apiPrefix}}/auth/features"
              ]
            },
            "description": "Qué flujos de cuenta ofrece esta API (para mostrar u ocultar opciones en el frontend).",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('flags', () => pm.expect(pm.response.json()).to.have.property('password_reset'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Resend verification",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/auth/email/verify/resend",
              "host": [
                "{{baseUrl}}{{apiPrefix}}/auth/email/verify/resend"
              ]
            },
            "description": "Reenvía el enlace de verificación. Sin sesión, con el email; con sesión, sin cuerpo. Siempre 202.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 202', () => pm.response.to.have.status(202));"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/auth/email/verify",
              "host": [
                "{{baseUrl}}{{apiPrefix}}/auth/email/verify"
              ]
            },
            "description": "Confirma el email con el token del correo (alta o cambio de email). Pulsarlo dos veces también da 204.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{verifyToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// pm.variables.get: vale igual si la variable está en un Environment o en la colección.",
                  "const token = pm.variables.get('verifyToken');",
                  "if (!token) {",
                  "  pm.test('sin verifyToken: la API rechaza la petición (400 token / 422 datos)', () => {",
                  "    pm.expect(pm.response.code).to.be.oneOf([400, 422]);",
                  "    if (pm.response.code === 400) pm.expect(pm.response.json().code).to.eql('invalid_or_expired_token');",
                  "  });",
                  "} else {",
                  "  pm.test('status 204', () => pm.response.to.have.status(204));",
                  "  if (pm.environment.has('verifyToken')) pm.environment.set('verifyToken', '');",
                  "  pm.collectionVariables.set('verifyToken', '');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Change email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/users/me/email",
              "host": [
