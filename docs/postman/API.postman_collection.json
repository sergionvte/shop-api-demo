  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/auth/register",
              "host": [
                "{{baseUrl}}{{apiPrefix}}/auth/register"
              ]
            },
            "description": "Crea una cuenta (JSON). Contraseña: 12+ caracteres, sin contener tu email. Con verificación de email activa responde 202 y el enlace llega por correo (ver carpeta Account).",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"full_name\": \"Nombre Apellido\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// 201 (sin verificación) o 202 (con EMAIL_VERIFICATION: mismo cuerpo para cualquier email)",
                  "pm.test(\"status 201/202\", () => pm.expect(pm.response.code).to.be.oneOf([201, 202]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/auth/login",
              "host": [
                "{{baseUrl}}{{apiPrefix}}/auth/login"
              ]
            },
            "description": "OAuth2 password flow: **x-www-form-urlencoded** (no JSON). Guarda access y refresh token.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "{{email}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{password}}",
                  "type": "text"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Guarda los tokens en variables de la colección para las siguientes peticiones.",
                  "if (pm.response.code === 200) {",
                  "  const d = pm.response.json();",
                  "  pm.collectionVariables.set(\"accessToken\", d.access_token);",
                  "  pm.collectionVariables.set(\"refreshToken\", d.refresh_token);",
                  "  pm.collectionVariables.set(\"accessTokenExpiresAt\", String(Date.now() + d.expires_in * 1000));",
                  "}",
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/users/me",
              "host": [
                "{{baseUrl}}{{apiPrefix}}/users/me"
              ]
            },
            "description": "Comprueba que el token funciona."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
