        {
          "name": "Logout (esta sesión)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/auth/logout",
              "host": [
                "{{baseUrl}}{{apiPrefix}}/auth/logout"
              ]
            },
            "description": "Revoca el refresh token (cierra esta sesión). El access token vigente sigue valiendo hasta su caducidad (máx. 15 min).",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}",
              "options": {
