        {
          "name": "Crear",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/<recurso>",
              "host": [
                "{{baseUrl}}{{apiPrefix}}/<recurso>"
              ]
            },
