          ]
        },
        {
          "name": "Validate reset token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/auth/password/reset/validate",
              "host": [
                "{{baseUrl}}{{apiPrefix}}/auth/password/reset/validate"
              ]
            },
            "description": "Comprueba, sin gastarlo, si el enlace sigue valiendo (204) o ha caducado (400).",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{resetToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// pm.variables.get: vale igual si la variable está en un Environment o en la colección.",
                  "const token = pm.variables.get('resetToken');",
                  "if (!token) {",
                  "  pm.test('sin resetToken: la API rechaza la petición (400 token / 422 datos)', () => {",
                  "    pm.expect(pm.response.code).to.be.oneOf([400, 422]);",
                  "    if (pm.response.code === 400) pm.expect(pm.response.json().code).to.eql('invalid_or_expired_token');",
                  "  });",
                  "} else {",
                  "  pm.test('status 204', () => pm.response.to.have.status(204));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Reset password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/auth/password/reset",
              "host": [
                "{{baseUrl}}{{apiPrefix}}/auth/password/reset"
              ]
            },
            "description": "Fija la contraseña nueva (un solo uso). Cierra todas las sesiones: después, Auth > Login con la contraseña nueva.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{resetToken}}\",\n  \"new_password\": \"{{newPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// pm.variables.get: vale igual si la variable está en un Environment o en la colección.",
                  "const token = pm.variables.get('resetToken');",
                  "if (!token) {",
                  "  pm.test('sin resetToken: la API rechaza la petición (400 token / 422 datos)', () => {",
                  "    pm.expect(pm.response.code).to.be.oneOf([400, 422]);",
                  "    if (pm.response.code === 400) pm.expect(pm.response.json().code).to.eql('invalid_or_expired_token');",
                  "  });",
                  "} else {",
                  "  pm.test('status 204', () => pm.response.to.have.status(204));",
                  "  // La contraseña nueva pasa a ser la de Login, en el ámbito donde esté `password`.",
                  "  const scope = pm.environment.has('password') ? pm.environment : pm.collectionVariables;",
                  "  scope.set('password', pm.variables.get('newPassword'));",
                  "  if (pm.environment.has('resetToken')) pm.environment.set('resetToken', '');",
                  "  pm.collectionVariables.set('resetToken', '');",
                  "  pm.collectionVariables.set('accessToken', '');",
                  "  pm.collectionVariables.set('refreshToken', '');",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Recursos (ejemplo)",
      "item": [
        {
