# ============================================================================
#  Configuración de la API. Copia a .env con:  apigen init-env
#  (producción / docker compose:  apigen init-env --production)
#  Toda variable se puede sobrescribir con variables de entorno reales.
#  Una variable vacía (VAR=) equivale a no definirla: se usa el valor por defecto.
# ============================================================================

# --- General -----------------------------------------------------------------
PROJECT_NAME="Tienda Demo API"
PROJECT_VERSION=0.1.0
# Texto de portada de /docs
PROJECT_DESCRIPTION=
# development | testing | production  (production activa validaciones estrictas)
ENVIRONMENT=development
DEBUG=false
# Vacío = activados salvo en producción
DOCS_ENABLED=
API_PREFIX=/api

# --- JWT -----------------------------------------------------------------------
# Mínimo 32 caracteres aleatorios. Genera una con: apigen secret
# (sin apigen: `openssl rand -base64 48` o
#  `python3 -c "import secrets; print(secrets.token_urlsafe(64))"`)
SECRET_KEY=change-me
# HS256 (clave compartida) o RS256/ES256/EdDSA (par de claves)
JWT_ALGORITHM=HS256
# JWT_PRIVATE_KEY_FILE=keys/private.pem
# JWT_PUBLIC_KEY_FILE=keys/public.pem
# Rotación de clave: pon aquí la(s) antigua(s), separadas por comas, durante 1 ciclo
JWT_PREVIOUS_SECRET_KEYS=
JWT_ISSUER=tienda-demo-api
JWT_AUDIENCE=tienda-demo-api-clients
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Política de acceso -----------------------------------------------------------
ALLOW_REGISTRATION=true
PASSWORD_MIN_LENGTH=12
# Tras LOGIN_MAX_ATTEMPTS fallos, la cuenta se bloquea para orígenes desconocidos
# (cada bloqueo consecutivo dobla la duración, hasta LOGIN_LOCKOUT_MAX_MINUTES).
# Desde una IP donde el usuario ya inició sesión en LOGIN_FAMILIAR_DAYS días puede
# seguir entrando. Un admin desbloquea con POST /api/v1/users/{id}/unlock.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# Bájalo (p. ej. 60) si prefieres menos fricción para quien entra desde una IP nueva.
LOGIN_LOCKOUT_MAX_MINUTES=240
LOGIN_FAMILIAR_DAYS=30
MAX_SESSIONS_PER_USER=10
# Retención: `apigen db prune` (a diario) borra los refresh tokens de sesiones
# muertas con más de LOGIN_FAMILIAR_DAYS días, y con ellos la IP guardada.
# Segundos en los que reutilizar un refresh token recién rotado, desde la misma IP,
# se trata como carrera legítima (409) y no como robo (0 = desactivado).
REFRESH_REUSE_GRACE_SECONDS=10
# Coste de Argon2id (RFC 9106). Cambiarlo re-hashea las contraseñas en el siguiente login.
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST_KIB=65536
ARGON2_PARALLELISM=4
PASSWORD_HASH_CONCURRENCY=8

# --- Base de datos -------------------------------------------------------------
# SQLite (desarrollo):  sqlite+aiosqlite:///./app.db
# PostgreSQL:           postgresql+asyncpg://usuario:clave@localhost:5432/basedatos
DATABASE_URL=sqlite+aiosqlite:///./app.db
# En producción SQLite da error salvo que lo confirmes aquí (demos, laboratorios).
ALLOW_SQLITE_IN_PRODUCTION=false
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_STATEMENT_TIMEOUT_MS=15000
# Solo docker compose (obligatoria): contraseña de PostgreSQL. init-env genera una
# aleatoria; a mano: `openssl rand -hex 24` (solo letras y números: va en la URL).
POSTGRES_PASSWORD=

# --- Rate limiting --------------------------------------------------------------
RATE_LIMIT_ENABLED=true
# memory:// (1 proceso) | redis://localhost:6379/0 (varios workers/instancias)
# Con Redis añade timeouts cortos: ...?socket_timeout=0.5&socket_connect_timeout=0.5
RATE_LIMIT_STORAGE_URI=memory://
RATE_LIMIT_STRATEGY=sliding-window-counter
# Por cliente (usuario o IP) y endpoint
RATE_LIMIT_DEFAULT=120/minute
# Por cliente, sumando todos los endpoints (no es un total del servidor)
RATE_LIMIT_GLOBAL=1000/minute
RATE_LIMIT_LOGIN=10/minute;50/hour
# Vacío = 5/hour en producción y 50/hour fuera de ella
RATE_LIMIT_REGISTER=
RATE_LIMIT_REFRESH=30/minute
RATE_LIMIT_HEADERS=true

# --- HTTP -------------------------------------------------------------------------
# Orígenes permitidos (separados por comas), p. ej. https://app.midominio.com
# Vacío en ENVIRONMENT=development: se permite cualquier http://localhost:<puerto>
# (y 127.0.0.1). En testing/producción, vacío = CORS desactivado.
CORS_ORIGINS=
CORS_ALLOW_CREDENTIALS=false
# En producción: tus dominios reales, p. ej. api.midominio.com
ALLOWED_HOSTS=*
# IPs/CIDR del proxy inverso (nginx, load balancer) para confiar en X-Forwarded-For
# y X-Forwarded-Proto. Sin esto, detrás de un proxy todos los clientes comparten IP
# (rate limit y bloqueo de login globales) y no se envía HSTS.
# Pon la IP exacta del proxy: en producción se rechazan '*', 0.0.0.0/0, ::/0 y
# redes más amplias que /8. El proxy debe SOBRESCRIBIR X-Forwarded-For
# (nginx: proxy_set_header X-Forwarded-For $remote_addr;).
# docker compose usa 172.30.57.1 (gateway de su red) si lo dejas vacío.
TRUSTED_PROXIES=
MAX_BODY_SIZE=1048576
GZIP_MIN_SIZE=1024
HSTS_SECONDS=63072000

# --- Tareas en segundo plano (apigen worker) -------------------------------
# Trabajos a la vez por worker y cada cuánto mira la cola (s)
JOBS_CONCURRENCY=4
JOBS_POLL_INTERVAL=1.0
# Procesos para las tareas con executor=process (CPU intensiva)
JOBS_PROCESS_WORKERS=2
# Trabajos pendientes máximos por usuario (0 = sin límite) y tamaños máximos
JOBS_MAX_PENDING_PER_USER=20
JOBS_MAX_PAYLOAD_BYTES=65536
JOBS_MAX_RESULT_BYTES=262144
# Días que se guardan los trabajos terminados (apigen db prune los borra)
JOBS_RETENTION_DAYS=7
JOBS_SHUTDOWN_GRACE=30
# Latido para el healthcheck del worker. Vacío = <tmp>/apigen-worker.heartbeat; fuera
# de Docker, con /tmp compartido por varios usuarios, mejor un directorio propio.
JOBS_HEARTBEAT_FILE=

# --- Cuentas: verificación de email y recuperación de contraseña -----------------
# off | optional | required. Con optional/required el registro responde 202 igual
# exista o no el email y envía el enlace de verificación. required: sin verificar
# no se puede iniciar sesión. Los usuarios que ya existían al migrar quedan verificados;
# si pasas a required más tarde, los registrados con off no lo están: márcalos con
# `apigen users verify --all-existing [--before AAAA-MM-DD]` (apigen check avisa).
EMAIL_VERIFICATION=off
# Recuperación de contraseña por correo (on | off)
PASSWORD_RESET=off
# URL del frontend del cliente. Los enlaces de los correos se construyen SOLO con
# esto (https en producción). Añade su origen a CORS_ORIGINS.
FRONTEND_URL=
# Rutas del frontend con {token} exactamente una vez; por defecto en el fragmento (#),
# que el navegador no envía a ningún servidor.
EMAIL_LINK_RESET="/reset-password#token={token}"
EMAIL_LINK_VERIFY="/verify-email#token={token}"
# Vida de los enlaces
TOKEN_TTL_RESET_MINUTES=30
TOKEN_TTL_VERIFY_HOURS=48
TOKEN_TTL_EMAIL_CHANGE_MINUTES=60
# Cupo por cuenta (independiente de la IP): segundos entre correos, por hora y por día.
# Vacío = 60 / 3 / 10 (producción) y 0 / 30 / 200 en development (para probar sin
# quedarte sin correos). Lo que se descarta queda en el log (email.suppressed).
EMAIL_PER_ACCOUNT_COOLDOWN_SECONDS=
EMAIL_PER_ACCOUNT_PER_HOUR=
EMAIL_PER_ACCOUNT_PER_DAY=
# Avisos de seguridad por cuenta y hora, y enlaces de cambio de email a una misma dirección
EMAIL_NOTICES_PER_ACCOUNT_PER_HOUR=5
EMAIL_PER_ADDRESS_PER_HOUR=3
# Cortacircuitos global (0 = sin límite), con un presupuesto aparte para los correos de
# seguridad (reset y avisos): las altas masivas no pueden bloquearlos
EMAIL_MAX_PER_HOUR=200
EMAIL_MAX_PER_DAY=1000
EMAIL_MAX_SECURITY_PER_HOUR=300
EMAIL_MAX_SECURITY_PER_DAY=2000
# Por IP. Vacío = 5/minute;20/hour en producción y 30/minute;300/hour fuera
RATE_LIMIT_EMAIL_REQUEST=
RATE_LIMIT_TOKEN_CONFIRM=10/minute;50/hour

# --- Correo ------------------------------------------------------------------------
# console (log; por defecto en development) | file (.eml en EMAIL_FILE_DIR) | smtp |
# disabled | custom (EMAIL_BACKEND_CLASS=app.<módulo>:<Clase>). Obligatorio en
# producción si usas verificación o recuperación.
EMAIL_BACKEND=
EMAIL_BACKEND_CLASS=
# queue (apigen worker) | inline (la API lo envía tras responder; solo desarrollo).
# Vacío = inline en development y queue en el resto.
EMAIL_DELIVERY=
# Remitente: una dirección del dominio DEL CLIENTE con SPF, DKIM y DMARC configurados
# (p. ej. no-reply@example.com). El nombre va aparte (vacío = MAIL_BRAND_NAME).
EMAIL_FROM=
EMAIL_FROM_NAME=
EMAIL_REPLY_TO=
EMAIL_FILE_DIR=var/mail
# Plantillas propias (ganan a las de serie, fichero a fichero): apigen email eject
EMAIL_TEMPLATES_DIR=email_templates
# SMTP (EMAIL_BACKEND=smtp). starttls (587) | ssl (465) | none (solo localhost/Mailpit).
# Solo el worker necesita estas credenciales.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
# Alternativa a SMTP_PASSWORD: fichero con la contraseña (Docker secrets)
SMTP_PASSWORD_FILE=
SMTP_TIMEOUT=20
# Marca en los correos (vacío = PROJECT_NAME, FRONTEND_URL y sin logo)
MAIL_BRAND_NAME="Tienda Demo API"
MAIL_BRAND_URL=
MAIL_BRAND_LOGO_URL=
MAIL_BRAND_COLOR="#2563eb"
MAIL_SUPPORT_EMAIL=
# Texto legal o dirección postal al pie
MAIL_FOOTER=
# Idioma por defecto y lista de idiomas con plantilla (se elige por Accept-Language)
MAIL_DEFAULT_LANGUAGE=es
MAIL_LANGUAGES=en,es

# --- Paginación ---------------------------------------------------------------------
PAGE_SIZE_DEFAULT=20
PAGE_SIZE_MAX=100
MAX_OFFSET=10000

# --- Logging -----------------------------------------------------------------------
LOG_LEVEL=INFO
# Vacío = JSON en producción
LOG_JSON=
